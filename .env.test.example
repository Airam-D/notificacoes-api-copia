# Copie este arquivo para .env.test e preencha a senha do MySQL.
# O .env.test é usado SOMENTE pelos testes (npm run test:integration).
# Ele aponta para um banco SEPARADO do banco de desenvolvimento: os testes apagam dados!
NODE_ENV=test

DB_HOST=localhost
DB_PORT=3306
DB_NAME=notificacoes_test
DB_USER=root
DB_PASSWORD=sua_senha_aqui
